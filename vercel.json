{
  "version": 2,
  "builds": [
    {
      "src": "docusaurus-project/**",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/docusaurus-project/build/index.html"
    }
  ],
  "public": true,
  "github": {
    "silent": true
  }
}